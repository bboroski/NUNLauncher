{
  "schema_version": 1,
  "repository": "bboroski/NUNLauncher",
  "default_base": "main",
  "fallback": "all",
  "fleet": [
    "bboroski/SAMBU",
    "bboroski/ToolNG",
    "bboroski/ReaperCripple",
    "bboroski/Kloz",
    "bboroski/CO",
    "bboroski/SaintSI",
    "bboroski/Klipot",
    "bboroski/NUN",
    "bboroski/NUNLauncher",
    "bboroski/Fragile-Baby",
    "bboroski/Luci",
    "bboroski/Hellduck",
    "bboroski/9circ"
  ],
  "suites": [
    {
      "id": "nunlauncher-host",
      "description": "Build the host validator, run CTest, and run repository checks",
      "paths": [
        "**/*.c",
        "**/*.h",
        "**/*.cpp",
        "**/*.hpp",
        "**/*.S",
        "**/*.s",
        "**/*.cmake",
        "**/CMakeLists.txt",
        "CMakeLists.txt",
        "Makefile",
        "**/Makefile",
        "**/*.ld",
        "**/*.mk",
        "**/*.json",
        "**/*.py",
        "one.py"
      ],
      "steps": [
        {
          "name": "Configure",
          "command": [
            "cmake",
            "-S",
            ".",
            "-B",
            "build/moontreach",
            "-DCMAKE_BUILD_TYPE=Release"
          ],
          "cwd": "."
        },
        {
          "name": "Build",
          "command": [
            "cmake",
            "--build",
            "build/moontreach",
            "--parallel"
          ],
          "cwd": "."
        },
        {
          "name": "Run CTest",
          "command": [
            "ctest",
            "--test-dir",
            "build/moontreach",
            "--output-on-failure"
          ],
          "cwd": "."
        },
        {
          "name": "Run repository checks",
          "command": [
            "python",
            "one.py",
            "check"
          ],
          "cwd": "."
        },
        {
          "name": "Run Make host tests",
          "command": [
            "make",
            "test"
          ],
          "cwd": "."
        }
      ],
      "runs_on": "ubuntu-latest",
      "timeout_seconds": 1800
    }
  ],
  "policy": {
    "auto_merge": false,
    "required_checks_must_pass": true,
    "draft_prs_block_merge": true,
    "merge_conflicts_block_merge": true,
    "never_bypass_branch_protection": true,
    "no_suite_means_unverified": true
  }
}
