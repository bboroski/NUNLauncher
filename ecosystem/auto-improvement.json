{
  "schema": "nun.auto-improvement.repository.v1",
  "repository": "bboroski/NUNLauncher",
  "domain": "desktop-control-plane",
  "role": "native-desktop-workbench",
  "capabilities": [
    "native-desktop-workbench",
    "repository-discovery",
    "read-only-host-observation",
    "three-stage-ternary-matrix-review",
    "matrix-evidence-export",
    "immutable-child-matrix-iterations",
    "improvement-orchestration",
    "rollback-planning"
  ],
  "policy": {
    "mode": "proposal-first",
    "automatic_actions": [
      "inventory",
      "read-host-metadata",
      "read-git-status",
      "analyze",
      "generate-matrix",
      "validate-matrix",
      "export-evidence",
      "create-child-matrix"
    ],
    "approval_required": [
      "write-files",
      "change-build-config",
      "install-software",
      "change-boot-config",
      "flash-firmware",
      "merge-pull-request"
    ],
    "guardrails": "native host application only; read-only observation by default; explicit approval for all writes, installs, boot changes, firmware operations and merges; never link desktop dependencies into the NUN freestanding C kernel"
  },
  "matrix": {
    "model": "ternary-three-stage",
    "stages": [
      "S1-observe-and-baseline",
      "S2-propose-and-validate",
      "S3-approve-and-apply"
    ],
    "states": [
      "-1=regression-or-block",
      "0=unknown-or-no-change",
      "1=verified-improvement"
    ],
    "evidence_required": true,
    "rollback_plan_required": true
  },
  "protocol": {
    "version": "1.0.0",
    "transport": "local-files-and-versioned-json",
    "no_remote_code_execution": true
  }
}
